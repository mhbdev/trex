# Runtime and persistence
# By default, the database is placed in the current OS user's application-data directory.
# Set DATABASE_URL=file:./data/wallex.sqlite to keep it inside this project instead.
LOG_LEVEL=info
ENGINE_MODE=shadow

# Wallex public API. Live trading additionally requires a credit-account key and sub-account id.
WALLEX_BASE_URL=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/connection/websocket
WALLEX_API_KEY=
WALLEX_SUB_ACCOUNT_CLIENT_ID=
WALLEX_ENABLE_LIVE_TRADING=false
WALLEX_ENABLE_AUTOTRADING=false
WALLEX_ALLOWED_MARKETS=BTCUSDT,ETHUSDT

# Challenge package's unavailableMarkets should also be populated from the authenticated package endpoint.
WALLEX_PACKAGE_ID=
WALLEX_QUOTE_CURRENCY=USDT
# Absolute ceiling for all live open positions, denominated in WALLEX_QUOTE_CURRENCY.
# Zero deliberately disables live execution until you choose a risk budget.
LIVE_MAX_GROSS_EXPOSURE=0

# AI SDK provider registry. Use openai, anthropic, google, compatible, boxapi, or liara.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_BASE_URL=
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
LIARA_API_KEY=
LIARA_WORKSPACE_ID=
LIARA_BASE_URL=https://ai.liara.ir
AI_REQUEST_TIMEOUT_SECONDS=60
AI_PROVIDER_KEYS_JSON={}
AI_ROLE_MODELS_JSON={}
ENGINE_STRATEGIES_JSON=[]
MARKET_QUOTE_FALLBACKS_JSON=[]
# Python TradingAgents defaults to one full bull/bear pair and one full three-role risk cycle.
ENGINE_MAX_DEBATE_ROUNDS=1
ENGINE_MAX_RISK_DISCUSS_ROUNDS=1
# Each memory decision is scored after its next-close entry plus this many completed 1m bars.
# 7200 bars equals five 24/7 crypto days. Lessons remain unavailable until their outcome resolves.
MEMORY_HOLDING_PERIOD_BARS=7200
# Leave blank to use BTC paired with the analyzed symbol's quote asset (e.g. BTC/TMN).
MEMORY_BENCHMARK_SYMBOL=

# Explicit virtual portfolio and execution assumptions.
PAPER_INITIAL_CASH=1000000
BACKTEST_FEE_BPS=10
BACKTEST_SLIPPAGE_BPS=5
RISK_MAX_ORDER_NOTIONAL=100000
RISK_MAX_POSITION_NOTIONAL=250000
RISK_MAX_GROSS_EXPOSURE=500000
RISK_MAX_DRAWDOWN_PCT=15
RISK_MAX_DAILY_LOSS=100000
RISK_MAX_DATA_AGE_SECONDS=30
RISK_FEE_BUFFER_BPS=50
RISK_MAX_MARKET_SLIPPAGE_BPS=50
RISK_KILL_SWITCH=false
